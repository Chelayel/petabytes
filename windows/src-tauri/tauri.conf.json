{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Petabytes",
  "version": "0.0.0",
  "identifier": "com.chelayel.petabytes",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node build.mjs"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Chelayel",
    "copyright": "MIT License. Built by Chelayel.",
    "shortDescription": "A coding pet that walks along your taskbar",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
