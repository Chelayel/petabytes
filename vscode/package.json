{
  "name": "tide-pets",
  "displayName": "Tide Pets",
  "description": "Sea creatures that live in your Explorer and react to what you do: a turtle, jellyfish, octopus, crab or pufferfish that swims faster while you type, celebrates saves and fixed errors, worries about new ones, and naps when you're away.",
  "version": "0.2.0",
  "publisher": "chelayel",
  "author": { "name": "Chelayel", "url": "https://www.chelayel.com" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chelayel/tide-pets.git"
  },
  "homepage": "https://github.com/Chelayel/tide-pets#readme",
  "bugs": {
    "url": "https://github.com/Chelayel/tide-pets/issues"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pet",
    "pets",
    "companion",
    "turtle",
    "jellyfish",
    "octopus",
    "crab",
    "pufferfish",
    "fun",
    "midnight tide"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "tidePets.pet",
          "name": "Tide Pets",
          "when": "config.tidePets.enabled"
        }
      ]
    },
    "commands": [
      {
        "command": "tidePets.choose",
        "title": "Choose Pet",
        "category": "Tide Pets",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "tidePets.toggle",
        "title": "Toggle Pet",
        "category": "Tide Pets"
      },
      {
        "command": "tidePets.show",
        "title": "Show Pet",
        "category": "Tide Pets"
      },
      {
        "command": "tidePets.hide",
        "title": "Hide Pet",
        "category": "Tide Pets",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tidePets.choose",
          "when": "view == tidePets.pet",
          "group": "navigation"
        },
        {
          "command": "tidePets.hide",
          "when": "view == tidePets.pet",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Tide Pets",
      "properties": {
        "tidePets.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the pet in the Explorer."
        },
        "tidePets.pet": {
          "type": "string",
          "default": "turtle",
          "enum": [
            "turtle",
            "jellyfish",
            "octopus",
            "crab",
            "pufferfish"
          ],
          "enumDescriptions": [
            "Shelly the sea turtle",
            "Bloop the jellyfish",
            "Inky the octopus",
            "Pinchy the crab",
            "Puff the pufferfish"
          ],
          "description": "Which pet lives in the Explorer."
        },
        "tidePets.name": {
          "type": "string",
          "default": "",
          "description": "Your pet's name. Leave empty for its own name (Shelly, Bloop, Inky, Pinchy or Puff)."
        }
      }
    }
  },
  "scripts": {
    "sync-page": "node -e \"for (const f of ['pet.html','pets.json']) require('fs').copyFileSync('../web/'+f,'media/'+f)\"",
    "vscode:prepublish": "npm run sync-page"
  }
}
