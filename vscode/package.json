{
  "name": "petabytes",
  "displayName": "Petabytes",
  "description": "Small companions with a big appetite. Sea creatures that live in your Explorer and react to what you do: they swim faster while you type, celebrate saves, commits and passing tests, notice the terminal and your AI assistant, eat the curly braces you feed them, and nap when you're away.",
  "version": "1.8.0",
  "publisher": "chelayel",
  "author": { "name": "Chelayel", "url": "https://www.chelayel.com" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chelayel/petabytes.git"
  },
  "homepage": "https://github.com/Chelayel/petabytes#readme",
  "bugs": {
    "url": "https://github.com/Chelayel/petabytes/issues"
  },
  "sponsor": {
    "url": "https://buymeacoffee.com/chelayel"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pet",
    "pets",
    "companion",
    "turtle",
    "octopus",
    "whale",
    "shark",
    "fun",
    "petabytes",
    "dolphin",
    "fish",
    "dog",
    "cat",
    "food",
    "pixel art",
    "rubber duck"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "petabytes.pet",
          "name": "Petabytes",
          "when": "config.petabytes.enabled"
        }
      ]
    },
    "commands": [
      {
        "command": "petabytes.choose",
        "title": "Choose Pet",
        "category": "Petabytes",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "petabytes.feed",
        "title": "Feed Pet",
        "category": "Petabytes",
        "icon": "$(heart)"
      },
      {
        "command": "petabytes.toggle",
        "title": "Toggle Pet",
        "category": "Petabytes"
      },
      {
        "command": "petabytes.show",
        "title": "Show Pet",
        "category": "Petabytes"
      },
      {
        "command": "petabytes.hide",
        "title": "Hide Pet",
        "category": "Petabytes",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "petabytes.feed",
          "when": "view == petabytes.pet",
          "group": "navigation"
        },
        {
          "command": "petabytes.choose",
          "when": "view == petabytes.pet",
          "group": "navigation"
        },
        {
          "command": "petabytes.hide",
          "when": "view == petabytes.pet",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Petabytes",
      "properties": {
        "petabytes.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the pet in the Explorer."
        },
        "petabytes.pet": {
          "type": "string",
          "default": "turtle",
          "enum": [
            "turtle",
            "jellyfish",
            "octopus",
            "crab",
            "pufferfish",
            "whale",
            "clownfish",
            "seahorse",
            "shark",
            "dolphin",
            "angelfish",
            "tang",
            "retriever",
            "spitz",
            "cat",
            "bunny",
            "hamster",
            "burger",
            "sushi",
            "pizza",
            "donut",
            "taco",
            "slime",
            "ghost",
            "knight",
            "robot",
            "laptop",
            "controller",
            "mug",
            "duck",
            "cactus",
            "floppy",
            "mouse",
            "headphones",
            "sticky"
          ],
          "enumDescriptions": [
            "Shelly the sea turtle",
            "Bloop the jellyfish",
            "Inky the octopus",
            "Pinchy the crab",
            "Puff the pufferfish",
            "Blue the whale",
            "Clem the clownfish",
            "Sandy the seahorse",
            "Finn the shark",
            "Splash the dolphin",
            "Angie the angelfish",
            "Indigo the blue tang",
            "Biscuit the golden retriever",
            "Loopee the German Spitz",
            "Byte the cat",
            "Clover the bunny",
            "Nugget the hamster",
            "Patty the burger",
            "Nori the sushi",
            "Pepe the pizza",
            "Sprinkles the donut",
            "Tuesday the taco",
            "Squish the slime",
            "Boo the ghost",
            "Sir Pix the knight",
            "Bolt the robot",
            "Lappy the laptop",
            "Joy the controller",
            "Java the coffee mug",
            "Quackers the rubber duck",
            "Spike the cactus",
            "Floppy the floppy disk",
            "Click the mouse",
            "Beats the headphones",
            "Post the sticky note"
          ],
          "description": "Which pet lives in the Explorer: a sea creature from the Tide set, a dog, cat, bunny or hamster from the Home set, a burger, sushi, pizza, donut or taco from the Snacks set, a pixel slime, ghost, knight or robot from the Games set, or a laptop, controller, mug, rubber duck, cactus, floppy disk, mouse, headphones or sticky note from the Gadgets set."
        },
        "petabytes.name": {
          "type": "string",
          "default": "",
          "description": "Your pet's name. Leave empty for its own (Shelly, Bloop, Inky, Pinchy, Puff, Blue, Clem, Sandy, Finn, Splash, Angie, Indigo, Biscuit, Loopee, Byte, Clover, Nugget, Patty, Nori, Pepe, Sprinkles, Tuesday, Squish, Boo, Sir Pix, Bolt, Lappy, Joy, Java, Quackers, Spike, Floppy, Click, Beats or Post)."
        }
      }
    }
  },
  "scripts": {
    "sync-page": "node -e \"for (const f of ['pet.html','pets.json','picker.html']) require('fs').copyFileSync('../web/'+f,'media/'+f)\"",
    "vscode:prepublish": "npm run sync-page"
  }
}
